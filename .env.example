# Copy this file to .env and fill in your key
# Get your free Groq API key at: https://console.groq.com

GROQ_API_KEY=gsk_your_key_here

# LiveKit Cloud voice transport
# Create these in LiveKit Cloud project settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional. Use this if your LiveKit agent is configured for explicit dispatch.
LIVEKIT_AGENT_NAME=david-portfolio-agent

# Shared portfolio memory for chat + LiveKit voice agent
# MONGODB_URI comes from MongoDB Atlas. VOYAGE_API_KEY can be a Voyage key or
# an Atlas-issued embedding key that starts with al-.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=chatfolio
VOYAGE_API_KEY=pa_your_voyage_or_atlas_embedding_key
